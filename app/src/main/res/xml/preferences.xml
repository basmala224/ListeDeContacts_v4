<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_affichage">
        <ListPreference
            app:key="taille_police"
            app:title="@string/pref_taille"
            app:entries="@array/tailles_libelles"
            app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:key="couleur_preferee"
            app:title="@string/pref_couleur"
            app:entries="@array/couleurs_libelles"
            app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="#000000"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_liste">
        <SwitchPreferenceCompat
            app:key="appel_depuis_liste"
            app:title="@string/pref_appel"
            app:summaryOn="@string/pref_appel_on"
            app:summaryOff="@string/pref_appel_off"
            app:defaultValue="false" />

        <!-- Bonus : ordre de tri appliqué par la clause ORDER BY -->
        <ListPreference
            app:key="ordre_tri"
            app:title="@string/pref_ordre"
            app:entries="@array/ordres_libelles"
            app:entryValues="@array/ordres_valeurs"
            app:defaultValue="nom"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
</PreferenceScreen>
